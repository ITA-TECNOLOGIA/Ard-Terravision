{
    "l1_input": {
        "type": "NumericalData",
        "params": {
            "datacube_path": "/datassd/proyectos/terravision/terravision_sensor_data/canteras/atmos/canteras_atmos.nc"
        }
    },
    "l2_algorithms": [
        {
            "type": "TimeSeriesTreatment",
            "params": {
                "sensor_config": "configs/data/canteras_atmos.yaml",
                "task_config": "configs/tasks/anomaly_detection.yaml"
            }
        }
    ],
    "l3_algorithms": [
        {
            "type": "TimeSeriesAnomalyDetection",
            "params": {
                "features": ["temperature_diff", "humidity_diff", "wind_mean_speed_diff"],
                "view_var": ["temperature", "humidity", "wind_mean_speed"],
                "contamination": 0.005,
                "n_estimators": 200,
                "zscore_detection": {
                    "enabled": true,
                    "variables": ["temperature", "humidity", "wind_mean_speed"],
                    "view_var": ["temperature", "humidity", "wind_mean_speed"],
                    "window": 50,
                    "theta": {"temperature": 5, "humidity": 10, "wind_mean_speed": 8},
                    "method": "mad"
                },
                "iforest_with_zscore": true,
                "iforest_without_zscore": true,
                "window": 50,
                "show_anomaly_table": true
            }
        }
    ],
    "l4_algorithm": {
        "type": "DummyLLaVACustom",
        "params": [
            {
                "time_index": 0
            }
        ]
    }
}
