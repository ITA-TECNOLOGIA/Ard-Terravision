{
    "l1_input": {
        "type": "NumericalData",
        "params": {
            "datacube_path": "/datassd/proyectos/terravision/terravision_sensor_data/ternamag/radar/ternamag_radar.nc"
        }
    },
    "l2_algorithms": [
        {
            "type": "TimeSeriesTreatment",
            "params": {
                "sensor_config": "configs/data/ternamag_radar.yaml",
                "task_config": "configs/tasks/anomaly_detection.yaml"
            }
        }
    ],
    "l3_algorithms": [
        {
            "type": "TimeSeriesAnomalyDetection",
            "params": {
                "features": ["displacement_diff"],
                "view_var": ["displacement"],
                "contamination": 0.005,
                "n_estimators": 200,
                "zscore_detection": {
                    "enabled": false,
                    "variables": ["displacement"],
                    "view_var": ["displacement"],
                    "window": 50,
                    "theta": 1.0,
                    "method": "mad"
                },
                "iforest_with_zscore": true,
                "iforest_without_zscore": true,
                "window": 50,
                "show_anomaly_table": true
            }
        }
    ],
    "l4_algorithm": {
        "type": "DummyLLaVACustom",
        "params": [
            {
                "time_index": 0
            }
        ]
    }
}
